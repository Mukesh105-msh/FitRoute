# FitRoute Backend Environment Configuration Template
# Duplicate this file to .env and fill in real values

# Server Environment
NODE_ENV=development
PORT=5000

# MySQL Database Configuration (Discrete Parameters)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fitroute_db
DB_PORT=3306

# Optional: Cloud Database SSL Configuration (true for TiDB Cloud / managed cloud MySQL)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional: Full Connection String (used by Railway, Render, etc.)
# If provided, this overrides DB_HOST/DB_USER/DB_PASSWORD
# DATABASE_URL=mysql://user:password@host:port/database

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# JWT Secret for Session Authentication
JWT_SECRET=your_secure_random_jwt_secret_key

# Frontend URL for CORS and OAuth redirects (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173
