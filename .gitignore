# Dependencies
node_modules/
backend/node_modules/

# Production build output
dist/
dist-ssr/
build/

# Environment and secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
*.env
backend/.env
backend/.env.*
*.local
.env.local
.env.*.local

# Allow example environment templates to be tracked
!.env.example
!backend/.env.example

# Logs and debug output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# System, temporary, and test artifacts
.DS_Store
Thumbs.db
*.tmp
*.temp
scratch/

# Editor and IDE configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
